<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent>
      <!-- Lets the app see which installed browsers offer Custom Tabs, and so Auth Tab (Android 11+ package visibility). -->
      <action android:name="android.support.customtabs.action.CustomTabsService" />
    </intent>
  </queries>
</manifest>
